# Session — required, ≥32 chars, env-only (not stored in Redis)
# Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# Redis – choose ONE of the following

# Option A: Upstash REST (Cloudflare Workers / Vercel / edge) – recommended
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: Self-hosted / Docker TCP (Node.js only)
# REDIS_URL="redis://localhost:6379"
# REDIS_URL="rediss://:password@host:6379/0"

# Dev server port – set via env (overrides Nuxt default 3000)
# PORT=9696
# NITRO_PORT=9696  # for pnpm preview / production
