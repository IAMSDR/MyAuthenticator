{
  "name": "myauthenticator",
  "private": true,
  "type": "module",
  "author": "IAMSDR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAMSDR/MyAuthenticator.git"
  },
  "homepage": "https://myauthenticator.pages.dev",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "deploy": "wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "NUXT_APP_SECRET": {
        "description": "App secret (>=32 chars). Generate with `openssl rand -base64 32`."
      },
      "UPSTASH_REDIS_REST_URL": {
        "description": "Upstash Redis REST URL from your database (e.g. `https://...upstash.io`)."
      },
      "UPSTASH_REDIS_REST_TOKEN": {
        "description": "Upstash Redis **read/write** REST token from the same database."
      }
    }
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.153",
    "@nuxt/ui": "^4.12.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@upstash/redis": "^1.41.0",
    "@vueuse/nuxt": "15.0.0",
    "bcryptjs": "^3.0.3",
    "idb-keyval": "^6.3.0",
    "ioredis": "^6.0.0",
    "long": "^5.3.2",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "0.6.2",
    "otpauth": "^9.6.0",
    "protobufjs": "^8.8.1",
    "qrcode.vue": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.5",
    "uncrypto": "^0.1.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-qrcode-reader": "^5.7.3",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@vite-pwa/nuxt": "1.1.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "ws": "^8.22.2"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
