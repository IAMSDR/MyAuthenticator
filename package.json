{
  "name": "myauthenticator",
  "private": true,
  "type": "module",
  "author": "IAMSDR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAMSDR/MyAuthenticator.git"
  },
  "homepage": "https://myauthenticator.pages.dev",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "deploy": "wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "NUXT_SESSION_PASSWORD": {
        "description": "Session encryption key (>=32 chars). Generate with `openssl rand -hex 32`."
      },
      "UPSTASH_REDIS_REST_URL": {
        "description": "Upstash Redis REST URL from your database (e.g. `https://...upstash.io`)."
      },
      "UPSTASH_REDIS_REST_TOKEN": {
        "description": "Upstash Redis **read/write** REST token from the same database."
      }
    }
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@nuxt/ui": "^4.11.1",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "@steveyuowo/vue-hot-toast": "^1.4.3",
    "@upstash/redis": "^1.38.4",
    "@vueuse/nuxt": "14.4.0",
    "bcryptjs": "^2.4.3",
    "idb-keyval": "^6.2.1",
    "ioredis": "^5.4.1",
    "long": "^5.3.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "otpauth": "^9.5.2",
    "protobufjs": "^7.6.3",
    "qrcode.vue": "^3.11.0",
    "tailwindcss": "^4.3.3",
    "uncrypto": "^0.1.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-qrcode-reader": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@vite-pwa/nuxt": "1.1.1",
    "eslint": "^10.10.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.14.0"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.21",
      "fast-uri": "^3.1.6",
      "minimatch@^3": "^3.1.4",
      "minimatch@^5": "^5.1.8",
      "minimatch@^9": "^9.0.7",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0",
      "browserslist": "^4.28.7",
      "serialize-javascript": "^7.0.5",
      "picomatch@^2": "^2.3.2",
      "flatted": "^3.4.2",
      "glob@^10": "^10.5.0",
      "rollup@^2": "^2.80.0",
      "defu": "^6.1.5",
      "drizzle-orm": "^0.45.2",
      "@humanfs/node": "^0.16.8",
      "@protobufjs/utf8": "^1.1.1",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "postcss-selector-parser@^7": "^7.1.5",
      "esbuild": "^0.28.1"
    }
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
