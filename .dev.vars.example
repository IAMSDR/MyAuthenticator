# Local secrets for `wrangler dev`. Copy to `.dev.vars` — never commit that file.

# App secret — required, ≥32 chars, env-only (not stored in Redis)
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# Upstash REST (Cloudflare Workers require REST, not TCP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
